PORT=3000
NODE_ENV=production
COOKIE_SECRET=change_this_to_a_random_secure_secret_string
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_password_on_production

# Cloudinary (Almacenamiento de fotos en la nube permanente y gratis)
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui
# O bien la URL completa proporcionada por Cloudinary:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
